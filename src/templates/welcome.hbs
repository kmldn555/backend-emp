<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Welcome</title>

    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f4f4f4;
        font-family: Arial, sans-serif;
        color: #333;
      }

      .container {
        max-width: 600px;
        margin: 40px auto;
        padding: 40px;
        background-color: #ffffff;
        border-radius: 8px;
      }

      h1 {
        margin-bottom: 20px;
        color: #222;
      }

      p {
        font-size: 16px;
        line-height: 1.6;
      }

      .footer {
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #eee;
        font-size: 14px;
        color: #777;
      }
    </style>
  </head>

  <body>
    <div class="container">
      <h1>Welcome, {{name}}! 👋</h1>

      <p>
        We're happy to have you with us.
      </p>

      <p>
        Thank you for joining us. We look forward to having you on board.
      </p>

      <div class="footer">
        Best regards,<br />
        <strong>The Team</strong>
      </div>
    </div>
  </body>
</html>